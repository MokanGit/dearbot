# DearBot production runtime example
ENV=production
DEBUG=false
BASE_URL=https://dearbot.example.com
API_BASE_URL=https://dearbot.example.com
NEXT_PUBLIC_API_URL=https://dearbot.example.com
CORS_ORIGINS=https://dearbot.example.com
ALLOWED_HOSTS=dearbot.example.com
# Enable only when the backend is reachable exclusively through the trusted proxy.
TRUST_PROXY_HEADERS=true

CANDIDATE_NAME="Your Name"
CANDIDATE_HEADLINE="Your Professional Headline"
CANDIDATE_SUMMARY="Replace with an evidence-grounded professional summary."
CANDIDATE_CONTACT_LINE="you@example.com | linkedin.com/in/your-profile"
NEXT_PUBLIC_CANDIDATE_NAME="Your Name"
NEXT_PUBLIC_CANDIDATE_HEADLINE="Your Professional Headline"
NEXT_PUBLIC_RESPONSIBLE_EDITOR="Self-Hosted Operator"
NEXT_PUBLIC_ORGANIZATION_NAME="DearBot"

DATABASE_URL="sqlite+aiosqlite:////app/backend/data/cv.db"
LOCAL_SYNC_DIR="/app/backend/data/synced_docs"
GENERATED_CVS_DIR="/app/backend/data/generated_cvs"

# Advanced: optional Google Drive ingestion
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_CV_TEMPLATE_DOC_ID=""
GOOGLE_SERVICE_ACCOUNT_FILE="/app/backend/service_account.json"

# AI model configuration
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"

# Optional observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="dearbot"
LANGSMITH_DASHBOARD_URL=""

# Production authentication must be enabled. See docs/authentication.md.
AUTH_MODE=entra
NEXT_PUBLIC_AUTH_MODE=entra
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_AUDIENCE="api://YOUR_API_CLIENT_ID"
ENTRA_REQUIRED_SCOPE="admin.access"
ADMIN_ALLOWED_OBJECT_IDS=[]
NEXT_PUBLIC_ENTRA_TENANT_ID=""
NEXT_PUBLIC_ENTRA_CLIENT_ID=""
NEXT_PUBLIC_ENTRA_API_SCOPE="api://YOUR_API_CLIENT_ID/admin.access"
