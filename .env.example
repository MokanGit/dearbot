# DearBot local development configuration

# Runtime
ENV=development
DEBUG=true
BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,test
TRUST_PROXY_HEADERS=false

# Fictional local profile. Replace before using DearBot with real applications.
CANDIDATE_NAME="Sample Candidate"
CANDIDATE_HEADLINE="Technology and Product Leader"
CANDIDATE_SUMMARY="Fictional sample profile for local DearBot development."
CANDIDATE_CONTACT_LINE="candidate@example.com | linkedin.com/in/example"
NEXT_PUBLIC_CANDIDATE_NAME="Sample Candidate"
NEXT_PUBLIC_CANDIDATE_HEADLINE="Technology and Product Leader"
NEXT_PUBLIC_RESPONSIBLE_EDITOR="Self-Hosted Operator"
NEXT_PUBLIC_ORGANIZATION_NAME="DearBot"
NEXT_PUBLIC_ORGANIZATION_URL=""

# Storage
DATABASE_URL="sqlite+aiosqlite:///./backend/data/cv.db"

# Advanced: optional Google Drive ingestion
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_CV_TEMPLATE_DOC_ID=""
GOOGLE_SERVICE_ACCOUNT_FILE="backend/service_account.json"
GOOGLE_CREDENTIALS_FILE="backend/credentials.json"

# Model provider: mock is deterministic and offline; gemini/openai require a key.
LLM_PROVIDER=mock
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"

# Optional tracing. Leave disabled unless CV data may be sent to the tracing service.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://eu.api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="dearbot"
LANGSMITH_DASHBOARD_URL=""

# Admin authentication
# disabled is accepted only in development/test. Production must use entra.
AUTH_MODE=disabled
NEXT_PUBLIC_AUTH_MODE=disabled
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_AUDIENCE=""
ENTRA_REQUIRED_SCOPE="admin.access"
# JSON array of immutable Entra object IDs. Empty permits any principal in the
# configured tenant that has the required API scope or app role.
ADMIN_ALLOWED_OBJECT_IDS=[]
NEXT_PUBLIC_ENTRA_TENANT_ID=""
NEXT_PUBLIC_ENTRA_CLIENT_ID=""
NEXT_PUBLIC_ENTRA_API_SCOPE=""
